<mvc:View
  controllerName="com.reply.contrattiattivi.comparator.controller.Dashboard"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:unified="sap.ui.unified">
  <Page showHeader="false">
    <customHeader>
      <Toolbar class="app-page-header">
        <Button icon="sap-icon://nav-back" type="Transparent" class="app-toolbar-btn" press="onNavBack" />
        <Title text="Dashboard Qualità Contratti" class="app-header-title" />
        <ToolbarSpacer />
        <Button text="Aggiorna" icon="sap-icon://refresh" press="onRefresh" />
      </Toolbar>
    </customHeader>
    <content>
      <VBox class="app-card app-card-padded sapUiSmallMargin">
        <HBox class="sapUiSmallMarginBottom">
          <VBox class="app-kpi-box">
            <Label text="Contratti verificati" />
            <Text text="{/kpi/totaleContratti}" class="app-kpi-value" />
          </VBox>
          <VBox class="app-kpi-box">
            <Label text="Completezza media" />
            <Text text="{/kpi/completezzaMedia}" class="app-kpi-value" />
          </VBox>
          <VBox class="app-kpi-box">
            <Label text="Contratti completi" />
            <Text text="{/kpi/contrattiCompleti}" class="app-kpi-value" />
          </VBox>
          <VBox class="app-kpi-box">
            <Label text="Deroghe totali" />
            <Text text="{/kpi/derogheTotali}" class="app-kpi-value" />
          </VBox>
          <VBox class="app-kpi-box">
            <Label text="Anomalie aperte" />
            <Text text="{/kpi/anomalieAperte}" class="app-kpi-value" />
          </VBox>
        </HBox>
      </VBox>

      <VBox class="app-card app-card-padded sapUiSmallMargin">
        <Title text="Andamento completezza (ultimi 30 giorni)" class="sapUiSmallMarginBottom" />
        <List id="andamentoList" items="{/andamento}" noDataText="Nessun dato">
          <items>
            <CustomListItem>
              <HBox alignItems="Center">
                <Text text="{data}" width="110px" />
                <ProgressIndicator percentValue="{completezzaMedia}" displayValue="{completezzaMedia}%" width="60%" showValue="true" state="{= ${completezzaMedia} >= 100 ? 'Success' : ${completezzaMedia} >= 50 ? 'Warning' : 'Error' }" />
                <Text text="contratti: {totaleContratti}" class="sapUiSmallMarginBegin" />
              </HBox>
            </CustomListItem>
          </items>
        </List>
      </VBox>

      <VBox class="app-card app-card-padded sapUiSmallMargin">
        <HBox class="sapUiSmallMarginBottom" alignItems="End">
          <VBox>
            <Label text="Filtro stato" />
            <Select id="filtroStato" width="200px" change="onFiltroChange">
              <core:Item key="" text="Tutti" />
              <core:Item key="APERTA" text="Aperta" />
              <core:Item key="ASSEGNATA" text="Assegnata" />
              <core:Item key="IN_LAVORAZIONE" text="In lavorazione" />
              <core:Item key="RISOLTA" text="Risolta" />
              <core:Item key="CHIUSA_SENZA_AZIONE" text="Chiusa senza azione" />
            </Select>
          </VBox>
          <VBox class="sapUiSmallMarginBegin">
            <Label text="Filtro tipo" />
            <Select id="filtroTipo" width="200px" change="onFiltroChange">
              <core:Item key="" text="Tutti" />
              <core:Item key="COMPLETEZZA" text="Completezza" />
              <core:Item key="DEROGHE" text="Deroghe" />
              <core:Item key="CONFIDENZA" text="Confidenza" />
            </Select>
          </VBox>
        </HBox>
        <Table id="anomalieTable" items="{/anomalie}" noDataText="Nessuna anomalia" mode="SingleSelectMaster">
          <columns>
            <Column><header><Text text="Contratto" /></header></Column>
            <Column><header><Text text="Tipo" /></header></Column>
            <Column><header><Text text="Riferimento" /></header></Column>
            <Column><header><Text text="Stato" /></header></Column>
            <Column><header><Text text="Assegnatario" /></header></Column>
            <Column><header><Text text="Azioni" /></header></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{intestatario}" />
                <Text text="{tipo}" />
                <Text text="{riferimento}" />
                <Text text="{stato}" />
                <Text text="{assegnatario}" />
                <HBox>
                  <Button text="Assegna" press="onAssegna" visible="{= ${stato} === 'APERTA' }" />
                  <Button text="Lavora" press="onAvviaLavorazione" visible="{= ${stato} === 'ASSEGNATA' }" />
                  <Button text="Risolvi" press="onRisolvi" visible="{= ${stato} === 'IN_LAVORAZIONE' }" />
                  <Button text="Chiudi" press="onChiudi" visible="{= ${stato} === 'APERTA' || ${stato} === 'ASSEGNATA' || ${stato} === 'IN_LAVORAZIONE' }" />
                </HBox>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>

      <Dialog id="assegnaDialog" title="Assegna anomalia">
        <VBox class="sapUiSmallMargin">
          <Label text="Assegnatario" />
          <Input id="assegnatarioInput" placeholder="email assegnatario" />
        </VBox>
        <beginButton>
          <Button text="Assegna" type="Emphasized" press="onAssegnaConfirm" />
        </beginButton>
        <endButton>
          <Button text="Annulla" press="onDialogClose" />
        </endButton>
      </Dialog>

      <Dialog id="risolviDialog" title="Risolvi anomalia">
        <VBox class="sapUiSmallMargin">
          <Label text="Nota correttiva" />
          <TextArea id="notaTextArea" width="100%" rows="3" />
          <unified:FileUploader id="fileUploader" buttonText="Scegli file" placeholder="Azione correttiva (opzionale)" width="100%" change="onFileChange" />
        </VBox>
        <beginButton>
          <Button text="Risolvi" type="Emphasized" press="onRisolviConfirm" />
        </beginButton>
        <endButton>
          <Button text="Annulla" press="onDialogClose" />
        </endButton>
      </Dialog>

      <Dialog id="chiudiDialog" title="Chiudi senza azione">
        <VBox class="sapUiSmallMargin">
          <Label text="Nota" />
          <TextArea id="chiudiNotaTextArea" width="100%" rows="3" />
        </VBox>
        <beginButton>
          <Button text="Chiudi" type="Emphasized" press="onChiudiConfirm" />
        </beginButton>
        <endButton>
          <Button text="Annulla" press="onDialogClose" />
        </endButton>
      </Dialog>
    </content>
  </Page>
</mvc:View>
