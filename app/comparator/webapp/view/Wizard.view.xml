<mvc:View
  controllerName="com.reply.contrattiattivi.comparator.controller.Wizard"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Page>
    <customHeader>
      <Toolbar class="app-page-header">
        <Button icon="sap-icon://nav-back" type="Transparent" class="app-toolbar-btn" press="onNavBack" />
        <Title text="Revisione documenti" class="app-header-title" />
        <ToolbarSpacer />
      </Toolbar>
    </customHeader>
    <content>
      <VBox class="sapUiSmallMargin app-page-content" width="{= ${aiPanel>/expanded} ? 'calc(100% - 380px - 1rem)' : 'calc(100% - 68px)' }">
        <Wizard id="reviewWizard" renderMode="Page" showNextButton="false" visible="false" stepActivate=".onWizardStepActivate" />
      </VBox>
      <core:Fragment fragmentName="com.reply.contrattiattivi.comparator.fragment.AiPanel" type="XML" />
    </content>
    <footer>
      <Toolbar class="app-btn-group sapUiSmallMargin">
        <ToolbarSpacer />
        <Button id="btnWizardIndietro" text="Indietro" press=".onWizardIndietro" enabled="false" class="app-btn" />
        <Button id="btnSalvaBozza" text="Salva bozza" press=".onSalvaBozza" class="app-btn" />
        <Button id="btnWizardAvanti" text="Avanti" press=".onWizardAvanti" type="Emphasized" class="app-btn app-btn-primary" />
      </Toolbar>
    </footer>
  </Page>
</mvc:View>
