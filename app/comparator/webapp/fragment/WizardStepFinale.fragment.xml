<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
  <VBox>
    <HBox class="sapUiSmallMarginBottom" alignItems="Center">
      <ObjectStatus text="Copertura: {coverage>/coveragePercent}%" state="{= ${coverage>/coveragePercent} >= 80 ? 'Success' : ${coverage>/coveragePercent} >= 50 ? 'Warning' : 'Error' }" />
      <Text text="File: {coverage>/filename}" class="sapUiSmallMarginBegin" />
    </HBox>

    <VBox visible="{= !!${coverage>/riferimentoTrovato} }" class="app-card app-card-padded sapUiSmallMarginBottom">
      <Label text="Riferimento riconosciuto automaticamente" design="Bold" />
      <Text text="{coverage>/riferimentoTrovato/nome} ({coverage>/riferimentoTrovato/tipo}) — similarity {= Math.round((${coverage>/riferimentoTrovato/similarity} || 0) * 100) }%" />
      <ObjectStatus
        visible="{= ${coverage>/coveragePercent} &lt; 50 }"
        text="Copertura clausole troppo bassa: questo riferimento potrebbe non essere coerente con il documento caricato, non trattarlo come confronto affidabile"
        state="Warning" icon="sap-icon://alert" class="sapUiTinyMarginTop" />

      <VBox visible="{= (${coverage>/riferimentoTrovato/candidati} || []).length > 1 }" class="sapUiSmallMarginTop">
        <Label text="Altri candidati possibili" design="Bold" class="sapUiTinyMarginBottom" />
        <Table items="{coverage>/riferimentoTrovato/candidati}" growing="true" growingThreshold="3">
          <columns>
            <Column><Text text="Template" /></Column>
            <Column width="8rem"><Text text="Similarity" /></Column>
            <Column width="8rem"><Text text="Copertura" /></Column>
            <Column width="8rem"></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <VBox>
                  <Text text="{coverage>nome} ({coverage>tipo})" />
                </VBox>
                <Text text="{= Math.round((${coverage>similarity} || 0) * 100) }%" />
                <Text text="{= Math.round(${coverage>coveragePercent} || 0) }%" />
                <Button text="Usa questo"
                  enabled="{= ${coverage>templateID} !== ${coverage>/riferimentoTrovato/templateID} }"
                  press=".onSelezionaCandidato" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>

      <Button text="Nessuno di questi: crea nuovo template da questo documento" icon="sap-icon://add-document"
        class="sapUiSmallMarginTop" press=".onApriCreaTemplate" />
    </VBox>
    <Button text="Crea nuovo template da questo documento" icon="sap-icon://add-document"
      visible="{= !${coverage>/riferimentoTrovato} }" class="sapUiSmallMarginBottom" press=".onApriCreaTemplate" />

    <VBox visible="{tips>/has}" class="app-card app-card-padded sapUiSmallMarginBottom">
      <HBox class="sapUiTinyMarginBottom" alignItems="Center">
        <core:Icon src="sap-icon://lightbulb" class="sapUiTinyMarginEnd" />
        <Label text="Tips AI" design="Bold" />
      </HBox>
      <List items="{ path: 'tips>/value', templateShareable: true }" noDataText="Nessun suggerimento.">
        <items>
          <StandardListItem
            icon="{= ${tips>tipo} === 'AGGIORNAMENTO' ? 'sap-icon://synchronize' : ${tips>tipo} === 'CLASSIFICAZIONE' ? 'sap-icon://document-text' : 'sap-icon://add-document' }"
            title="{tips>messaggio}" wrapping="true" />
        </items>
      </List>
    </VBox>

    <VBox visible="{mancanti>/has}" class="app-table-wrap sapUiSmallMarginBottom">
      <Label text="Clausole mancanti rispetto al template" design="Bold" class="sapUiSmallMarginBottom" />
      <Table items="{ path: 'mancanti>/value', templateShareable: true }" growing="true" growingThreshold="50">
        <columns>
          <Column width="6rem"><Text text="Clausola" /></Column>
          <Column><Text text="Titolo" /></Column>
          <Column><Text text="Testo (dal template)" /></Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <Text text="{mancanti>codice}" />
              <Text text="{mancanti>titolo}" />
              <Text text="{mancanti>testo}" wrapping="true" />
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </VBox>

    <VBox visible="{compliance>/hasPresenti}" class="app-table-wrap sapUiSmallMarginBottom">
      <Table items="{ path: 'compliance>/presenti', templateShareable: true }" growing="true" growingThreshold="50">
        <columns>
          <Column><Text text="Parti Contratto" /></Column>
          <Column width="10rem"><Text text="Esito" /></Column>
          <Column><Text text="Dettaglio" /></Column>
          <Column><Text text="Riferimento" /></Column>
          <Column width="8rem"><Text text="Match % (Similarity)" /></Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <VBox>
                <Text text="{compliance>requisito}" />
                <Text text="{compliance>clausolaID}" visible="{= !!${compliance>clausolaID} }" class="app-id-badge" />
              </VBox>
              <ObjectStatus text="{compliance>esito}" state="{path: 'compliance>esito', formatter: '.formatter.esitoState'}" />
              <Text text="{compliance>dettaglio}" />
              <Text text="{compliance>riferimento}" />
              <Text text="{compliance>similarity}" />
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </VBox>

    <core:Fragment fragmentName="com.reply.contrattiattivi.comparator.fragment.EsitiVerifica" type="XML" />
  </VBox>
</core:FragmentDefinition>
