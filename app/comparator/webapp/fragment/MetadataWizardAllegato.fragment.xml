<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout"
  xmlns:control="com.reply.contrattiattivi.comparator.control">
  <l:Splitter height="50vh" class="sapUiSmallMarginTop">
    <VBox class="sapUiSmallMargin" items="{allegati>sezioni}">
      <layoutData>
        <l:SplitterLayoutData size="32%" />
      </layoutData>
      <Panel headerText="{allegati>sezione}" expandable="true" expanded="true"
        class="sapUiTinyMarginBottom">
        <Table items="{allegati>campi}" noDataText="Nessun campo per questa sezione.">
          <columns>
            <Column width="30%"><Text text="Campo" /></Column>
            <Column><Text text="Valore" /></Column>
            <Column width="8rem"><Text text="Confidenza" /></Column>
          </columns>
          <items>
            <ColumnListItem type="Active" press=".onCampoMetadatoAllegatoPress">
              <cells>
                <Text text="{allegati>etichetta}" />
                <Input value="{allegati>valore}" liveChange=".onCampoMetadatoAllegatoModificato" />
                <ObjectStatus text="{= ${allegati>confidenza} !== null &amp;&amp; ${allegati>confidenza} !== undefined ? Math.round(${allegati>confidenza} * 100) + '%' : '—' }"
                  state="{path: 'allegati>confidenza', formatter: '.metadataWizardHelper.statoConfidenza'}" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </Panel>
    </VBox>
    <VBox class="sapUiSmallMargin">
      <layoutData>
        <l:SplitterLayoutData size="68%" />
      </layoutData>
      <Text text="Anteprima documento" class="app-hint-text sapUiTinyMarginBottom" />
      <control:PdfPreview id="allegatoPdfPreview" pdfBase64="{allegati>pdfBase64}"
        visible="{= !!${allegati>pdfBase64} }" />
      <TextArea value="{allegati>testo}" editable="false" width="100%" height="55vh"
        visible="{= !${allegati>pdfBase64} }" />
    </VBox>
  </l:Splitter>
</core:FragmentDefinition>
