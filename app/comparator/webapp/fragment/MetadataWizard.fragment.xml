<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout"
  xmlns:control="com.reply.contrattiattivi.comparator.control">
  <l:Splitter height="60vh" class="sapUiSmallMarginTop">
    <VBox class="sapUiSmallMargin" width="60%" items="{wizardSezioni>/}">
      <Panel headerText="{wizardSezioni>sezione}" expandable="true" expanded="true"
        class="sapUiTinyMarginBottom">
        <Table items="{wizardSezioni>campi}" noDataText="Nessun campo per questa sezione.">
          <columns>
            <Column width="30%"><Text text="Campo" /></Column>
            <Column><Text text="Valore" /></Column>
            <Column width="8rem"><Text text="Confidenza" /></Column>
          </columns>
          <items>
            <ColumnListItem type="Active" press=".onCampoMetadatoPress">
              <cells>
                <Text text="{wizardSezioni>etichetta}" />
                <Input value="{wizardSezioni>valore}" liveChange=".onCampoMetadatoModificato" />
                <ObjectStatus text="{= ${wizardSezioni>confidenza} !== null &amp;&amp; ${wizardSezioni>confidenza} !== undefined ? Math.round(${wizardSezioni>confidenza} * 100) + '%' : '—' }"
                  state="{path: 'wizardSezioni>confidenza', formatter: '.metadataWizardHelper.statoConfidenza'}" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </Panel>
    </VBox>
    <VBox class="sapUiSmallMargin" width="40%">
      <Text text="Anteprima documento" class="app-hint-text sapUiTinyMarginBottom" />
      <control:PdfPreview id="contractPdfPreview" pdfBase64="{wizardDocumento>/pdfBase64}" />
    </VBox>
  </l:Splitter>
</core:FragmentDefinition>
