<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout"
  xmlns:control="com.reply.contrattiattivi.comparator.control">
  <l:Splitter height="60vh" class="sapUiSmallMarginTop">
    <VBox class="sapUiSmallMargin" items="{ path: 'wizardSezioni>/', templateShareable: true }">
      <layoutData>
        <l:SplitterLayoutData size="32%" />
      </layoutData>
      <Panel expandable="true" expanded="true" class="sapUiTinyMarginBottom">
        <headerToolbar>
          <Toolbar>
            <Title text="{wizardSezioni>sezione}" level="H5" />
            <ToolbarSpacer />
            <Button icon="sap-icon://add" text="Aggiungi clausola" type="Transparent"
              visible="{= ${wizardSezioni>sezione} === 'Clausole di rischio' }"
              press=".onAggiungiClausola" />
          </Toolbar>
        </headerToolbar>
        <Table items="{ path: 'wizardSezioni>campi', templateShareable: true }" noDataText="Nessun campo per questa sezione.">
          <columns>
            <Column width="30%"><Text text="Campo" /></Column>
            <Column><Text text="Valore" /></Column>
          </columns>
          <items>
            <ColumnListItem type="Active" press=".onCampoMetadatoPress">
              <cells>
                <Text text="{wizardSezioni>etichetta}" />
                <VBox>
                  <Input value="{wizardSezioni>valore}" liveChange=".onCampoMetadatoModificato"
                    visible="{= !${wizardSezioni>isClausola} }" />
                  <TextArea value="{wizardSezioni>valore}" liveChange=".onCampoMetadatoModificato"
                    rows="3" width="100%" visible="{= !!${wizardSezioni>isClausola} }" />
                </VBox>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </Panel>
    </VBox>
    <VBox class="sapUiSmallMargin">
      <layoutData>
        <l:SplitterLayoutData size="68%" />
      </layoutData>
      <Text text="Anteprima documento" class="app-hint-text sapUiTinyMarginBottom" />
      <control:PdfPreview id="contractPdfPreview" pdfBase64="{wizardDocumento>/pdfBase64}"
        visible="{= !!${wizardDocumento>/pdfBase64} }" />
      <TextArea value="{wizardDocumento>/testo}" editable="false" width="100%" height="55vh"
        visible="{= !${wizardDocumento>/pdfBase64} }" />
    </VBox>
  </l:Splitter>
</core:FragmentDefinition>
