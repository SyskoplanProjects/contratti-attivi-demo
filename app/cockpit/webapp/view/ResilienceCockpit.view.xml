<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" controllerName="com.buyerui.buyerui.controller.ResilienceCockpit"
	xmlns:html="http://www.w3.org/1999/xhtml">
	<Shell>
		<Page>
			<customHeader>
				<Toolbar class="gesub-userBar">
					<core:Fragment fragmentName="com.buyerui.buyerui.view.fragments.HomeBar.NavigationButton" type="XML"/>
					<ToolbarSpacer/>
					<Button text="Home" type="Transparent" class="gesub-home-btn" press="onPressHome" icon="sap-icon://home"></Button>
					<ToolbarSpacer/>
					<core:Fragment fragmentName="com.buyerui.buyerui.view.fragments.HomeBar.UserInfoAndLogout" type="XML"/>
				</Toolbar>
			</customHeader>
			<content>
				<core:ComponentContainer width="100%" height="100%" id="ResilienceCockpit" propagateModel="true"/> 
			</content>
		</Page>
	</Shell>
</mvc:View>