<mvc:View
  controllerName="com.reply.contrattiattivi.app.controller.TemplateDetail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Page>
    <customHeader>
      <Toolbar class="app-page-header">
        <Button icon="sap-icon://nav-back" type="Transparent" class="app-toolbar-btn" press="onNavBack" />
        <Title text="{contesto>/nome}" class="app-header-title" />
        <ToolbarSpacer />
      </Toolbar>
    </customHeader>
    <content>
      <VBox class="sapUiSmallMargin app-page-content" width="{= ${aiPanel>/expanded} ? 'calc(100% - 380px - 1rem)' : 'calc(100% - 68px)' }">
        <Text class="app-hint-text" text="{contesto>/tipoServizio}" />
        <VBox class="app-table-wrap">
          <Table id="versioniTable" items="{contesto>/versioni}">
            <columns>
              <Column><Text text="Versione" /></Column>
              <Column><Text text="Data Creazione" /></Column>
              <Column><Text text="Note" /></Column>
            </columns>
            <items>
              <ColumnListItem type="Navigation" press="onVersionePress">
                <cells>
                  <Text text="v{contesto>numero}" />
                  <Text text="{contesto>dataCreazione}" />
                  <Text text="{contesto>note}" />
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </VBox>
      </VBox>
      <Panel headerText="Commenti" expandable="true" expanded="true">
        <VBox class="sapUiSmallMargin">
          <HBox class="sapUiSmallMarginBottom">
            <TextArea id="nuovoCommentoTemplateInput" width="100%" rows="2" placeholder="Aggiungi un commento su questo template..." />
            <Button text="Invia" class="sapUiTinyMarginBegin" press="onInviaCommentoTemplate" />
          </HBox>
          <List items="{commenti>/value}" noDataText="Nessun commento.">
            <items>
              <CustomListItem>
                <HBox class="sapUiTinyMargin" alignItems="Center" justifyContent="SpaceBetween">
                  <VBox>
                    <Text text="{commenti>autore}" class="app-hint-text" />
                    <Text text="{commenti>testo}" wrapping="true" />
                  </VBox>
                  <HBox alignItems="Center">
                    <ObjectStatus text="{commenti>stato}" state="{= ${commenti>stato} === 'APERTO' ? 'Warning' : 'Success' }" class="sapUiTinyMarginEnd" />
                    <Button text="Risolvi" visible="{= ${commenti>stato} === 'APERTO' }" press="onRisolviCommentoTemplate" />
                  </HBox>
                </HBox>
              </CustomListItem>
            </items>
          </List>
        </VBox>
      </Panel>
      <Panel headerText="Alert modifiche clausole" expandable="true" expanded="false" visible="{alertModel>/hasAlerts}">
        <List items="{alertModel>/alerts}">
          <items>
            <StandardListItem title="{alertModel>clausolaCodice}" description="{alertModel>dataModifica}" info="{alertModel>numContratti} contratti" type="Navigation" press="onAlertDetail"/>
          </items>
        </List>
      </Panel>
      <core:Fragment fragmentName="com.reply.contrattiattivi.app.fragment.AiPanel" type="XML" />
    </content>
  </Page>
</mvc:View>
