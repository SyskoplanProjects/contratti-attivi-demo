<mvc:View
  controllerName="com.reply.contrattiattivi.app.controller.Archiviati"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Page>
    <customHeader>
      <Toolbar class="app-page-header">
        <Button icon="sap-icon://nav-back" type="Transparent" class="app-toolbar-btn" press="onNavBack" />
        <Title text="Contratti Archiviati" class="app-header-title" />
      </Toolbar>
    </customHeader>
    <content>
      <VBox class="sapUiSmallMargin app-page-content">
        <Table id="archiviatiTable" items="{path: '/Contratto', filters: [{path: 'stato', operator: 'EQ', value1: 'ARCHIVIATO'}]}" growing="true" growingThreshold="50">
          <columns>
            <Column><Text text="Intestatario" /></Column>
            <Column><Text text="Responsabile" /></Column>
            <Column><Text text="Data archiviazione" /></Column>
            <Column><Text text="Stato" /></Column>
            <Column width="8rem"><Text text="" /></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{intestatario}" />
                <Text text="{responsabile}" />
                <Text text="{dataArchiviazione}" />
                <ObjectStatus text="{stato}" state="{path: 'stato', formatter: '.formatter.statoState'}" />
                <Button text="Ripristina" icon="sap-icon://undo" press="onRipristina" class="app-btn app-btn-success" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </content>
  </Page>
</mvc:View>
