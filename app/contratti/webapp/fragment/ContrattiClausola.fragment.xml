<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
  <Dialog id="contrattiClausolaDialog" title="Contratti che usano la clausola" contentWidth="30rem">
    <content>
      <List id="contrattiClausolaList" items="{contratti>/}" noDataText="Nessun contratto usa questa clausola.">
        <items>
          <ObjectListItem title="{path: 'contratti>contrattoID', formatter: '.formatter.shortID'}">
            <firstStatus>
              <ObjectStatus text="{contratti>stato}" />
            </firstStatus>
            <secondStatus>
              <ObjectStatus text="Anteprima" icon="sap-icon://search" press=".onAnteprimaContratto" active="true" />
            </secondStatus>
            <attributes>
              <ObjectAttribute text="{= 'Versione ' + ${contratti>versione} }" />
            </attributes>
          </ObjectListItem>
        </items>
      </List>
    </content>
    <endButton>
      <Button text="Chiudi" press=".onChiudiContrattiClausola" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>
