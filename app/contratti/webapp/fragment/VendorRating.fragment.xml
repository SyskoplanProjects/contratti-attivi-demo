<core:FragmentDefinition controllerName="com.reply.contrattiattivi.app.controller.Dashboard" xmlns:core="sap.ui.core" xmlns="sap.m">
  <VBox class="sapUiSmallMargin app-dash-tab">
    <HBox class="app-dash-filterbar sapUiSmallMarginBottom" wrap="Wrap" alignItems="End" justifyContent="SpaceBetween">
      <VBox class="app-dash-filter-field">
        <Label text="Fornitore" />
        <Input id="vendorRicerca" width="16rem" placeholder="Cerca fornitore..." />
      </VBox>
      <Button text="Esegui" type="Emphasized" press="onEseguiFiltriVendor" class="app-btn app-btn-primary" />
    </HBox>
    <MessageStrip type="Information" showIcon="true" class="sapUiTinyMarginBottom"
      visible="{= !!${vendor>/vuoto} }" text="Nessun fornitore con contratti attivi." />
    <VBox id="vendorPanel" class="app-table-wrap">
      <Table id="vendorTable" growing="true" growingThreshold="50" items="{vendor>/righe}">
        <columns>
          <Column><Text text="Fornitore" /></Column>
          <Column><Text text="Fatturato dichiarato" /></Column>
          <Column><Text text="Totale contratti" /></Column>
          <Column><Text text="N. contratti" /></Column>
          <Column><Text text="Indice dipendenza" /></Column>
          <Column><Text text="Rischio" /></Column>
        </columns>
        <items>
          <ColumnListItem type="Navigation" press="onApriContrattiFornitore">
            <cells>
              <Link text="{vendor>nome}" press="onApriReportFornitore" />
              <Text text="{path:'vendor>fatturatoTot', formatter:'.formatter.euroText', targetType:'any'}" />
              <Text text="{path:'vendor>totaleContratti', formatter:'.formatter.euroText', targetType:'any'}" />
              <Link text="{vendor>numeroContratti}" press="onApriContrattiFornitore" />
              <core:HTML content="{vendor>indiceHtml}" />
              <ObjectStatus text="{vendor>rischioLabel}" state="{vendor>rischioState}" />
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </VBox>

    <VBox id="contrattiDrillVendor" visible="false" class="sapUiMediumMarginTop">
      <Toolbar>
        <Button icon="sap-icon://nav-back" type="Transparent" press="onDrillBackVendor" />
        <Title text="{= 'Contratti di ' + ${contrattiFornitoreVendor>/nome} }" level="H2" />
      </Toolbar>
      <VBox class="app-table-wrap">
        <Table id="contrattiFornitoreTableVendor" growing="true" growingThreshold="50"
          items="{contrattiFornitoreVendor>/righe}">
          <columns>
            <Column><Text text="Codice" /></Column>
            <Column><Text text="Fornitore" /></Column>
            <Column><Text text="Rischio" /></Column>
            <Column><Text text="Responsabile" /></Column>
            <Column><Text text="Oggetto" /></Column>
            <Column><Text text="Categoria" /></Column>
            <Column><Text text="Stato" /></Column>
            <Column><Text text="Importo" /></Column>
            <Column><Text text="Data Stipula" /></Column>
            <Column><Text text="Data Scadenza" /></Column>
          </columns>
          <items>
            <ColumnListItem type="Navigation" press="onApriContrattoDettaglio">
              <cells>
                <Text text="{contrattiFornitoreVendor>codice}" />
                <Text text="{contrattiFornitoreVendor>intestatario}" />
                <ObjectStatus text="{contrattiFornitoreVendor>rischioLabel}" state="{contrattiFornitoreVendor>rischioState}" />
                <Text text="{contrattiFornitoreVendor>responsabile}" />
                <Text text="{contrattiFornitoreVendor>oggetto}" />
                <Text text="{path:'contrattiFornitoreVendor>categoria', formatter:'.formatter.categoriaText'}" />
                <ObjectStatus text="{contrattiFornitoreVendor>stato}" state="{path:'contrattiFornitoreVendor>stato', formatter:'.formatter.statoState'}" />
                <Text text="{path:'contrattiFornitoreVendor>importo', formatter:'.formatter.euroText', targetType:'any'}" />
                <Text text="{contrattiFornitoreVendor>dataStipula}" />
                <Text text="{contrattiFornitoreVendor>dataScadenza}" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </VBox>
  </VBox>
</core:FragmentDefinition>