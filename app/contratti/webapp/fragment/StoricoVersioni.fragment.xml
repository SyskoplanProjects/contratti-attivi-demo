<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog id="dialogStoricoVersioni" title="Storico versioni contrattuali" contentWidth="34rem" contentHeight="32rem" resizable="true">
    <content>
      <VBox class="sapUiContentPadding">
        <Text text="Seleziona due versioni per confrontarle." class="app-hint-text" />
        <VBox class="app-timeline" items="{versioni>/versioni}">
          <HBox class="app-timeline-row">
            <VBox class="app-timeline-dot-col">
              <core:Icon src="sap-icon://circle-task-2" size="0.7rem" class="app-timeline-dot" color="{path: 'versioni>corrente', formatter: '.formatter.timelineDotColor'}" />
              <VBox class="app-timeline-connector" visible="{= !${versioni>ultima} }" />
            </VBox>
            <VBox class="app-card app-card-hoverable app-card-padded" width="100%">
              <HBox alignItems="Center" justifyContent="SpaceBetween">
                <HBox alignItems="Center">
                  <Text text="{path: 'versioni>numero', formatter: '.formatter.versionePillText'}" class="app-id-badge sapUiTinyMarginEnd" />
                  <ObjectStatus text="{versioni>stato}" state="{path: 'versioni>stato', formatter: '.formatter.statoState'}" />
                  <core:Icon src="sap-icon://flag" visible="{versioni>corrente}" class="app-icon-warning sapUiTinyMarginBegin" />
                </HBox>
                <CheckBox selected="{path: 'versioni>sel', type: 'sap.ui.model.type.Boolean'}" text="Confronta" />
              </HBox>
              <HBox class="sapUiTinyMarginTop" alignItems="Center">
                <core:Icon src="sap-icon://calendar" class="app-timeline-meta-icon" />
                <Text text="{path: 'versioni>dataVersione', type: 'sap.ui.model.type.DateTime', formatOptions: {pattern: 'dd/MM/yyyy HH:mm'}}" class="sapUiSmallMarginEnd" />
                <core:Icon src="sap-icon://list" class="app-timeline-meta-icon" />
                <Text text="{versioni>totaleClausole} clausole" />
              </HBox>
            </VBox>
          </HBox>
        </VBox>
      </VBox>
    </content>
    <beginButton>
      <Button id="btnConfrontaVersioni" text="Confronta selezionate" icon="sap-icon://compare" enabled="false" press="onConfrontaVersioniContratto" class="app-btn app-btn-primary" />
    </beginButton>
    <endButton>
      <Button text="Chiudi" press="onChiudiStoricoVersioni" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>
